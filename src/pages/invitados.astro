---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Invitados - Marce & Pipe"
  description="La búsqueda de invitaciones para la boda de Marce & Pipe está cerrada."
>
  <main class="min-h-screen bg-[#f4f3ef] flex items-center justify-center px-6 text-center">
    <section class="max-w-md">
      <img src="/Recurso 1@1000x.png" alt="Marce & Pipe" class="h-20 w-auto mx-auto mb-8" />
      <p class="text-[#1d1d1d]/50 tracking-[0.3em] uppercase text-sm mb-4">Invitados</p>
      <h1 class="text-4xl text-[#1d1d1d] mb-4" style="font-family: 'Reina Neue Display', serif">
        Confirmaciones cerradas
      </h1>
      <p class="text-[#1d1d1d]/70 leading-relaxed">
        Ya cerramos la lista de invitados y no estamos recibiendo más confirmaciones.
        Si tienes alguna duda, por favor contacta directamente a los novios.
      </p>
      <a
        href="/"
        class="mt-8 inline-block rounded-full border border-[#213500]/30 px-6 py-3 text-sm text-[#213500] transition-colors hover:bg-[#213500] hover:text-white"
      >
        Volver al inicio
      </a>
    </section>
  </main>
</Layout>
